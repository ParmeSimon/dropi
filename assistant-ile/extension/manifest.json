{
  "manifest_version": 3,
  "name": "Assistant Island : mots de passe",
  "version": "1.0.0",
  "description": "Quand tu te connectes à un site, confie l'identifiant et le mot de passe à l'assistant de ce PC. Rien ne part sur internet.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "background": {
    "service_worker": "fond.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icone16.png",
    "48": "icone48.png",
    "128": "icone128.png"
  }
}
